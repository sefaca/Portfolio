---
// Marca "S" de Sergio: monograma de dos trazos simétricos con canal diagonal
// (hereda color vía currentColor)
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <g
    stroke="currentColor"
    stroke-width="6.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M 65 27 H 47 C 40 27 38 30 38 36 V 44 C 38 48 39 50.5 42 53 L 51.5 58.5"></path>
    <path
      d="M 65 27 H 47 C 40 27 38 30 38 36 V 44 C 38 48 39 50.5 42 53 L 51.5 58.5"
      transform="rotate(180 50 50)"></path>
  </g>
</svg>
